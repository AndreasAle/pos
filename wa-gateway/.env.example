# Token untuk API gateway (samakan dengan YOKA_WA_GATEWAY_TOKEN di Laravel).
# Buat: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GATEWAY_TOKEN=

# URL webhook Laravel yang sudah ada (sama dengan yang dulu dipasang di Fonnte):
# https://yokapos.com/platform-ai/whatsapp/webhook/<YOKA_FONNTE_WEBHOOK_SECRET>
WEBHOOK_URL=

PORT=3100
# 127.0.0.1 = hanya bisa diakses dari server sendiri (lewat reverse proxy HTTPS).
HOST=127.0.0.1
DATA_DIR=./data

# Rem anti-spam (opsional, default di src/guard.js)
# REPLY_WINDOW_HOURS=24
# PER_NUMBER_HOURLY=20
# PER_NUMBER_DAILY=60
# GLOBAL_PER_MINUTE=12
# GLOBAL_DAILY=500
# COLD_DAILY=20
# COLD_GAP_HOURS=72
# MIN_GAP_MS=2500
