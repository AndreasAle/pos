<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <!-- Tests run on MySQL (not SQLite) because migrations and PosOrderService
             use MySQL-specific SQL: ALTER TABLE ... MODIFY COLUMN ENUM and SUBSTRING_INDEX.
             Create the DB once: CREATE DATABASE fnb_pos_test; -->
        <env name="DB_CONNECTION" value="mysql"/>
        <env name="DB_DATABASE" value="fnb_pos_test"/>
        <env name="MAIL_MAILER" value="array"/>
        <!-- Third-party integrations are pinned off so the suite behaves the same
             on every machine and never reaches a real API. Tests that need the
             configured path set the config value themselves. -->
        <env name="MIDTRANS_SERVER_KEY" value=""/>
        <env name="MIDTRANS_CLIENT_KEY" value=""/>
        <env name="MIDTRANS_IS_PRODUCTION" value="false"/>
        <env name="FONNTE_TOKEN" value=""/>
        <env name="PLATFORM_FEE_PERCENT" value="0"/>
        <!-- Optional modules ship disabled, but their behaviour still has to be
             covered: turn them on for the suite so the routes exist here. -->
        <env name="FEATURE_AUDIT_LOG" value="true"/>
        <env name="FEATURE_SUBSCRIPTION" value="true"/>
        <env name="FEATURE_BALANCE" value="true"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
    </php>
</phpunit>
