APP_NAME="Yoka POS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Opsional: aktifkan bahasa generatif untuk Tanya Yoka. Tanpa key, parser lokal tetap bekerja.
YOKA_AI_API_KEY=
YOKA_AI_BASE_URL=https://api.openai.com/v1
YOKA_AI_MODEL_DEEP=
YOKA_AI_MODEL=gpt-4.1-mini

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=mail@conweb.id
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="mail@conweb.id"
MAIL_FROM_NAME="Yoka POS"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Login Google (OAuth Web Application)
# Redirect URI produksi harus persis: https://yokapos.com/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# ── Midtrans (QRIS dinamis + pembayaran langganan) ───────────────────────────
# Sandbox: gunakan Server Key dari tabel "Server Keys", Client Key, dan
# Signature Secret Key dari dashboard Sandbox. Ketiganya adalah key berbeda
# pada dashboard Midtrans baru. Biarkan MIDTRANS_IS_PRODUCTION=false.
# Notification URL: ${APP_URL}/midtrans/callback
# Jangan pernah commit key asli. Jika kosong, checkout langganan akan dinonaktifkan.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_SIGNATURE_SECRET=
MIDTRANS_IS_PRODUCTION=false

# ── Fonnte (kirim struk via WhatsApp) ────────────────────────────────────────
# Kosongkan untuk menonaktifkan struk WhatsApp.
FONNTE_TOKEN=

# ── Platform ─────────────────────────────────────────────────────────────────
# Persentase fee yang dipotong dari tiap transaksi QRIS merchant (0 = tanpa fee).
PLATFORM_FEE_PERCENT=0

# ── Modul opsional ───────────────────────────────────────────────────────────
# Hanya relevan kalau aplikasi dijalankan sebagai SaaS multi-tenant.
# Untuk satu restoran yang memakai POS-nya sendiri, biarkan false.
FEATURE_AUDIT_LOG=false
FEATURE_SUBSCRIPTION=false
FEATURE_BALANCE=false

# Bot Telegram (buat lewat @BotFather, lalu jalankan: php artisan telegram:webhook)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
