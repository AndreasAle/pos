APP_NAME="Yoka POS"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

# Opsional: aktifkan bahasa generatif untuk Tanya Yoka. Tanpa key, parser lokal tetap bekerja.
YOKA_AI_API_KEY=
YOKA_AI_BASE_URL=https://api.openai.com/v1
YOKA_AI_MODEL_DEEP=
YOKA_AI_MODEL=gpt-4.1-mini
YOKA_AI_DAILY_COST_BUDGET_USD=5
YOKA_AI_INPUT_COST_PER_MILLION=0.40
YOKA_AI_OUTPUT_COST_PER_MILLION=1.60

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=support@yokapos.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="support@yokapos.com"
MAIL_FROM_NAME="Yoka POS"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Pembayaran self-order. Jangan commit key produksi.
PAYMENT_PROVIDER=bayarpro
BAYARPRO_BASE_URL=https://bayar-pro.com
BAYARPRO_SERVER_KEY=
BAYARPRO_MERCHANT_ID=
BAYARPRO_WEBHOOK_SECRET=

# Login Google (OAuth Web Application)
# Redirect URI produksi harus persis: https://yokapos.com/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# ── Midtrans (QRIS dinamis + pembayaran langganan) ───────────────────────────
# Sandbox: gunakan Server Key dari tabel "Server Keys", Client Key, dan
# Signature Secret Key dari dashboard Sandbox. Ketiganya adalah key berbeda
# pada dashboard Midtrans baru. Biarkan MIDTRANS_IS_PRODUCTION=false.
# Notification URL: ${APP_URL}/midtrans/callback
# Jangan pernah commit key asli. Jika kosong, checkout langganan akan dinonaktifkan.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_SIGNATURE_SECRET=
MIDTRANS_IS_PRODUCTION=false

# ── Fonnte (kirim struk via WhatsApp) ────────────────────────────────────────
# Kosongkan untuk menonaktifkan struk WhatsApp.
FONNTE_TOKEN=

# ── Tim AI platform (eksekusi eksternal) ────────────────────────────────────
# Isi hanya di environment server. Tanpa key, agen tetap menganalisis data
# internal tetapi tidak dapat membaca sosial media, membuat ads, atau membalas WA.
META_MARKETING_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_INSTAGRAM_ACCOUNT_ID=
TIKTOK_MARKETING_ACCESS_TOKEN=
TIKTOK_ADVERTISER_ID=
WHATSAPP_BUSINESS_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
# Token Fonnte milik Yoka untuk follow-up trial (terkirim hanya setelah disetujui).
YOKA_FONNTE_TOKEN=
YOKA_FONNTE_WEBHOOK_SECRET=
# Jalur kirim WA resmi Yoka: "fonnte" (default) atau "gateway" (wa-gateway/ milik sendiri).
# Webhook masuk tetap sama untuk keduanya.
YOKA_WA_DRIVER=fonnte
YOKA_WA_GATEWAY_URL=
YOKA_WA_GATEWAY_TOKEN=
YOKA_WA_GATEWAY_SOCKET=

# ── Platform ─────────────────────────────────────────────────────────────────
# Persentase fee yang dipotong dari tiap transaksi QRIS merchant (0 = tanpa fee).
PLATFORM_FEE_PERCENT=0

# ── Modul opsional ───────────────────────────────────────────────────────────
# Hanya relevan kalau aplikasi dijalankan sebagai SaaS multi-tenant.
# Untuk satu restoran yang memakai POS-nya sendiri, biarkan false.
FEATURE_AUDIT_LOG=false
FEATURE_SUBSCRIPTION=false
FEATURE_BALANCE=false

# GoFood lewat GoBiz API (https://developer.gobiz.com). Kosong = hanya mencatat pendaftaran.
# Redirect URI harus sama persis dengan yang didaftarkan ke Gojek, mis. https://yokapos.com/integrasi/gofood/callback
GOBIZ_CLIENT_ID=
GOBIZ_CLIENT_SECRET=
GOBIZ_REDIRECT_URI=
GOBIZ_OAUTH_URL=https://integration-goauth.gojekapi.com
GOBIZ_API_URL=https://api.partner-sandbox.gobiz.co.id

# ShopeeFood OpenAPI (https://developer.shopeefood.co.id/vendor/api-docs). Kosong = endpoint masuk 404.
# VendorID/Secret DIBERIKAN Shopee. INBOUND_* dan INDICATOR kita buat sendiri lalu kita serahkan ke Shopee
# (client_secret maksimal 200 karakter). URL endpoint Yoka: https://yokapos.com/api/shopeefood/{INDICATOR}
SHOPEEFOOD_VENDOR_ID=
SHOPEEFOOD_VENDOR_SECRET=
SHOPEEFOOD_API_URL=https://food-open.uat.shopee.co.id
SHOPEEFOOD_INBOUND_CLIENT_ID=
SHOPEEFOOD_INBOUND_CLIENT_SECRET=
SHOPEEFOOD_INDICATOR=

# Bot Telegram (buat lewat @BotFather, lalu jalankan: php artisan telegram:webhook)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Telegram Virtual Office untuk tujuh agen AI platform. Buat token dan secret
# berbeda per bot. Jangan commit nilai sebenarnya.
TELEGRAM_OFFICE_TIMEOUT=10
TELEGRAM_OFFICE_BRIEFING_TIME=08:00
TELEGRAM_RAMLI_TOKEN=
TELEGRAM_RAMLI_USERNAME=
TELEGRAM_RAMLI_WEBHOOK_SECRET=
TELEGRAM_YUSUF_TOKEN=
TELEGRAM_YUSUF_USERNAME=
TELEGRAM_YUSUF_WEBHOOK_SECRET=
TELEGRAM_YONO_TOKEN=
TELEGRAM_YONO_USERNAME=
TELEGRAM_YONO_WEBHOOK_SECRET=
TELEGRAM_LUNA_TOKEN=
TELEGRAM_LUNA_USERNAME=
TELEGRAM_LUNA_WEBHOOK_SECRET=
TELEGRAM_NANDA_TOKEN=
TELEGRAM_NANDA_USERNAME=
TELEGRAM_NANDA_WEBHOOK_SECRET=
TELEGRAM_ADIT_TOKEN=
TELEGRAM_ADIT_USERNAME=
TELEGRAM_ADIT_WEBHOOK_SECRET=
TELEGRAM_YOSEF_TOKEN=
TELEGRAM_YOSEF_USERNAME=
TELEGRAM_YOSEF_WEBHOOK_SECRET=

# Backup database terenkripsi (php artisan yoka:backup). Key: base64 32 byte acak,
# simpan salinannya di luar server — tanpa key, backup tidak bisa dipulihkan.
YOKA_BACKUP_ENABLED=false
YOKA_BACKUP_KEY=
YOKA_BACKUP_PATH=
YOKA_BACKUP_KEEP_DAYS=14
YOKA_BACKUP_ALERT_EMAIL=
